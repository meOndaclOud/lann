# Supabase — public client configuration.
# Safe to expose to the browser (NEXT_PUBLIC_ prefix), per ARCHITECTURE.md §51.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side AI provider key.
# Must never be prefixed with NEXT_PUBLIC_ and must never be read from client code.
# Only server routes / Edge Functions may use it, per ARCHITECTURE.md §17 and §43.
AI_PROVIDER_API_KEY=
