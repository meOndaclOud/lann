# Server-side only — never exposed to the browser (see server/mentorProvider.ts).
# Without this, the AI Mentor gracefully reports itself as temporarily
# unavailable instead of erroring; the rest of the app keeps working.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if not set.
# GEMINI_MODEL=gemini-3.6-flash

# Server-side only — never exposed to the browser (see server/communityProvider.ts).
# A Meta Page Access Token with read permissions for the pages listed in
# server/communitySources.ts. Without this, the Community feature falls back
# to cached or sample data instead of erroring; the rest of the app keeps working.
FACEBOOK_ACCESS_TOKEN=

# Optional — defaults to v19.0 if not set.
# FACEBOOK_GRAPH_API_VERSION=v19.0
